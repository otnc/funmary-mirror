{
	// apps/web 以外の TypeScript をまとめて検査する。apps/web は svelte-check で検査する (設計書 6.2)
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"exactOptionalPropertyTypes": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["packages/*/src/**/*", "packages/*/*.ts", "scripts/**/*", "*.ts"],
	"exclude": ["**/node_modules", "apps"]
}
